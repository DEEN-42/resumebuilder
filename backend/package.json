    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "Controllers/**/*.js",
      "Routes/**/*.js",
      "middleware/**/*.js",
      "!**/node_modules/**"
    ]
  },
  "dependencies": {
