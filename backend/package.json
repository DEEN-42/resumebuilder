    "bullmq": "^5.70.4",
    "cloudinary": "^2.7.0",
    "cors": "^2.8.5",
    "dotenv": "^17.0.1",
    "express": "^5.1.0",
    "google-auth-library": "^10.1.0",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "lib0": "^0.2.117",
    "mongodb": "^6.17.0",
    "mongoose": "^8.16.1",
    "multer": "^2.0.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^9.0.5",
    "redis": "^5.6.1",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0",
    "validator": "^13.15.15",
    "ws": "^8.19.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.29"
  }
